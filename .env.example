# Backend only. Never expose private keys through NEXT_PUBLIC_* variables.
MARKET_DATA_PROVIDER=auto
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_CACHE_SECONDS=60
MARKET_DATA_TIMEOUT_SECONDS=10
ALLOW_DEMO_FALLBACK=true
MARKET_DATA_SYMBOL=XAU

# Optional authorized local options file. Keep blank to disable this provider.
MARKET_DATA_CSV_PATH=

# Runtime paths and CORS (optional).
XAU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
